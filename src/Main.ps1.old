# ========== FONCTION DE LOG GLOBALE ==========
$script:logFile = "C:\Users\alexa\Documents\ConventionDeNommage\odm_debug.log"

function Write-DebugLog {
    param(
        [string]$Message,
        [string]$Level = "INFO",
        [string]$Location = ""
    )
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss.fff"
    $logEntry = "[$timestamp] [$Level] [$Location] $Message"
    Add-Content -Path $script:logFile -Value $logEntry -Encoding UTF8 -ErrorAction SilentlyContinue
    Write-Host $logEntry -ForegroundColor $(switch($Level){"ERROR"{"Red"} "WARNING"{"Yellow"} "SUCCESS"{"Green"} default{"Cyan"}})
}

$scriptPath = Split-Path -Parent $MyInvocation.MyCommand.Path

